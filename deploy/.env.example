# Synthetic local-only configuration. Do not reuse these values outside development.
COMPOSE_PROJECT_NAME=paquetenvia-local

POSTGRES_HOST_PORT=5432
POSTGRES_DB=paquetenvia_local
POSTGRES_USER=paquetenvia_local_admin
POSTGRES_PASSWORD=local-only-postgres-change-me

REDIS_HOST_PORT=6379
REDIS_PASSWORD=local-only-redis-change-me

MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ROOT_USER=paquetenvia-local
MINIO_ROOT_PASSWORD=local-only-minio-change-me
MINIO_BUCKET=paquetenvia-proofs
AWS_ACCESS_KEY_ID=paquetenvia-local
AWS_SECRET_ACCESS_KEY=local-only-minio-change-me
ProofStorage__Provider=S3Compatible
ProofStorage__ThreatScanner=Synthetic
ProofStorage__ServiceUrl=http://127.0.0.1:9000
ProofStorage__PublicPresignUrl=http://127.0.0.1:9000
ProofStorage__Region=us-east-1
ProofStorage__Bucket=paquetenvia-proofs
ProofStorage__ProcessingIntervalSeconds=5
ProofStorage__StaleValidationSeconds=300
ProofStorage__MaximumConcurrency=4

MAIL_SMTP_HOST_PORT=1025
MAIL_UI_HOST_PORT=8025
